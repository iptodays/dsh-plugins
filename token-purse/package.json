{
  "name": "@dsh-plugins/token-purse",
  "version": "0.1.12",
  "description": "TokenPurse（鲸囊）— 把 DSH 会话累计消耗的 token 折算成大致现金，显示在输入框下方的会话统计行。",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "token", "cost", "usage", "web"],
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "scripts", "README.md", "README.en.md", "cordis.patch.yml", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/client.js && node --check scripts/build.mjs && node --check lib/client.js",
    "test": "node scripts/smoke.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}